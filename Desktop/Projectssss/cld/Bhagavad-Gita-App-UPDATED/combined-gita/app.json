{
  "expo": {
    "name": "Bhagavad Gita",
    "slug": "bhagavad-gita",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "bhagavadgita",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.yourcompany.bhagavadgita",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#11152B"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#15112A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
