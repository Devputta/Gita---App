{
  "name": "bhagavad-gita",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:validate-sanskrit": "node scripts/validate-sanskrit.mjs",
    "db:import-sanskrit": "node scripts/import-sanskrit.mjs",
    "content:import-translations": "node scripts/import-translations.mjs",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "web:build": "expo export --platform web",
    "release:audit": "node scripts/release-audit.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@prisma/client": "6.19.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.18",
    "expo-auth-session": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "prisma": "6.19.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": []
    }
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
